# Configurações de Integração Munaya E-commerce

# 1. API Dimona (Camisa Dimona Print-on-Demand)
# Obtenha sua chave no painel da Dimona em: Configurações / Avançado
DIMONA_API_KEY=sua_api_key_dimona_aqui
DIMONA_API_URL=https://admin.camisadimona.com.br/api/v2

# 2. Nuvemshop API
# Subdomínio provisório e credenciais da loja
NEXT_PUBLIC_STORE_URL=https://munayarocks.lojavirtualnuvem.com.br
NUVEMSHOP_STORE_ID=8403729
NUVEMSHOP_ACCESS_TOKEN=seu_access_token_nuvemshop_aqui
